# ============================================================================
# polyuni — universe-wide Polymarket arbitrage bot
# Copy to `.env` and edit. Everything below has a safe default in config.py.
# NEVER put a real key/secret in THIS file — it is the checked-in template.
# ============================================================================

# ---- API endpoints ----
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com

# ---- Market universe ----
# Comma-separated whitelist of market slugs/ids to force-track regardless of
# filters. Empty = filters alone decide the universe.
MARKET_WHITELIST=
# Minimum Gamma `liquidityNum` (USD) for a market to qualify.
MIN_LIQUIDITY_USD=500.0
# Minimum Gamma `volume24hr` (USD) for a market to qualify.
MIN_VOLUME_24H_USD=1000.0
# Maximum best-bid/best-ask spread (tighter leg) sampled from the CLOB book at
# discovery time. Markets wider than this rarely produce a real YES+NO<1 dip.
MAX_SPREAD_AT_MID=0.05
# Exclude markets resolving sooner than this (seconds) — no time to fill both legs.
MIN_TIME_TO_RESOLUTION_S=30
# Exclude markets resolving later than this (seconds). Empty = no cap.
MAX_TIME_TO_RESOLUTION_S=
# Require Gamma `enableOrderBook=true` (always; not configurable — a market
# without an order book cannot be arbed).
# Exclude negRisk (multi-outcome) markets — combined-ask math differs; out of
# scope for v1.
EXCLUDE_NEG_RISK=true
# How often to scan Gamma for newly-eligible markets (seconds).
UNIVERSE_RESCAN_INTERVAL_S=60
# How often to re-check already-tracked markets against the filters above,
# dropping any that stopped qualifying (closed, liquidity dried up) (seconds).
UNIVERSE_REQUALIFY_INTERVAL_S=60
# Upper bound on concurrently-tracked (CLOB-subscribed) markets. Over-capacity
# qualified markets are ranked by volume24hr; only the top N are promoted.
MAX_CONCURRENT_MARKETS=50
# Explicitly merge current+next BTC 5m/15m markets from Gamma's official
# market-by-slug route; bulk /markets pagination does not include them.
INCLUDE_BTC_SHORT_WINDOWS=true

# ---- Strategy ----
# "sequential" (default) buys one discounted side near the start of a volatile
# market, then waits for the opposite side to become cheap enough to lock a
# fee-positive pair. "dual" preserves the old simultaneous YES+NO detector.
STRATEGY_MODE=sequential
# Legacy dual-strategy edge floor.
MIN_EDGE=0.01
# Base order size (shares) per leg.
ORDER_SIZE=10.0

# Sequential first-leg gate: only early, near 50/50, and after this much locally
# observed price movement across at least SEQUENTIAL_MIN_SAMPLES raw book updates.
SEQUENTIAL_ENTRY_WINDOW_S=120
SEQUENTIAL_VOLATILITY_LOOKBACK_S=20
SEQUENTIAL_MIN_LOCAL_MOVE=0.015
SEQUENTIAL_MIN_SAMPLES=3
SEQUENTIAL_NEAR_EVEN_BAND=0.08
SEQUENTIAL_FIRST_LEG_MAX_PRICE=0.48
# Opposite leg is acquired later only if both actual depth-walked fills, including
# official taker fees, still clear SEQUENTIAL_MIN_NET_EDGE per share.
SEQUENTIAL_SECOND_LEG_MAX_PRICE=0.48
SEQUENTIAL_SECOND_LEG_TIMEOUT_S=30
SEQUENTIAL_MIN_NET_EDGE=0.0025
# Retained for configuration compatibility; a completed/aborted market is consumed
# until release, so the engine never starts a second sequence in the same window.
SEQUENTIAL_COOLDOWN_S=30
STRATEGY_SNAPSHOT_PATH=state/strategy_snapshot.json

# Gamma's per-market feeSchedule overrides these conservative fallbacks.
CRYPTO_TAKER_FEE_RATE=0.07
DEFAULT_TAKER_FEE_RATE=0.05

# Fresh BTC-volatility regime exported by the sibling btc5m process.
# This adjusts only the BTC Up/Down first-leg local-volatility threshold; it never
# predicts direction and never blocks an already-open second leg or exit.
LIGHTGBM_REGIME_PATH=../btc5m/state/regime_active.json
LIGHTGBM_REGIME_MAX_AGE_S=900
POLYUNI_LIGHTGBM_MIN_CONFIDENCE=0.45
LIGHTGBM_HIGH_VOL_MULTIPLIER=0.75
LIGHTGBM_LOW_VOL_MULTIPLIER=1.25

# ---- Execution auth (leave blank for DRY_RUN) ----
# Private key of the trading wallet (0x...). If empty, bot runs in DRY_RUN.
PRIVATE_KEY=
# Optional proxy/funder wallet address (the address that receives fills).
PROXY_WALLET=
# Polymarket CLOB V2 API credentials (L2 HMAC auth). Leave blank on the first
# authenticated PAPER_TRADE run; the SDK derives them locally. Real exchange
# order submission is intentionally unbuilt — see LIVE mode note below.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ---- Polygon status / paper signing ----
# Read-only balance/status checks use eth_getBalance and eth_call. PAPER_TRADE
# signs synthetic approval payloads locally but never broadcasts them.
POLYGON_RPC_URL=https://polygon.drpc.org
APPROVAL_MAX_GAS_PRICE_GWEI=80.0

# ---- Paper-fill fidelity ----
# "rest_book" (default) fetches each leg's real order book at submission time
# and requires full requested depth within the limit price — a leg can
# genuinely fail to fill, which is what exercises the partial-fill/hedge
# recovery path. "decision_snapshot" skips that REST round trip and always
# fills at the WS decision price — faster, but models no depth/slippage at
# all. Use decision_snapshot only for quick local iteration, never for
# evidence you intend to treat as go-live proof.
PAPER_FILL_SOURCE=rest_book

# ---- Transport ----
USE_WS=true
POLL_INTERVAL_S=0.25

# ---- Risk ----
MAX_POSITION_PER_MARKET=200.0
MAX_TOTAL_CAPITAL=1000.0
MIN_LIQUIDITY_PER_SIDE=5.0
STALE_BOOK_TIMEOUT_S=5.0
DAILY_KILL_SWITCH_USD=500.0
# Hard cap on residual losses per partial-fill event before the kill switch trips.
PARTIAL_LOSS_CAP_USD=25.0
# When hedging a missing leg, only do so if remaining edge covers this floor.
PARTIAL_HEDGE_MIN_EDGE=0.0
# Maximum time gap (ms) between legs before treating as partial fill.
MAX_LEG_GAP_MS=300
# Slippage stress buffer applied on top of entry edge for slice survival test.
# Must be > 0 or the stress test degenerates to the entry-edge condition and
# can never fail — validated at startup, an invalid value refuses to boot.
SLIPPAGE_STRESS_BUFFER=0.01
# Maximum age (ms) of the older leg quote before rejecting a fire.
MAX_QUOTE_AGE_MS=500
# Hold paired-leg evaluation this long so adjacent CLOB frames form one coherent pair.
CROSS_LEG_SETTLE_MS=10.0
# No NEW entries in the final N seconds before a market's own resolution time --
# spreads tend to whip right before the outcome becomes certain. Distinct from
# MIN_TIME_TO_RESOLUTION_S above (that's a discovery-time universe filter; this
# is the tight, per-fire gate on an already-tracked market's live decisions).
NO_ENTRY_SECONDS=5.0
# Path to a file; if it exists, trading halts immediately (manual emergency stop).
EMERGENCY_STOP_FILE=state/EMERGENCY_STOP

# ---- Observability ----
LOG_JSONL=state/bot.jsonl
LOG_LEVEL=INFO
# How often the running bot writes a PnL snapshot (seconds). This is what makes
# the dashboard's PnL panel "live" instead of only updating at shutdown.
PNL_PUBLISH_INTERVAL_S=5.0

# ---- Safety ----
# Safe local mode. Exactly one of DRY_RUN/PAPER_TRADE must be true.
DRY_RUN=true
# PAPER_TRADE: when dry_run=false and PAPER_TRADE=true, the bot runs the real
# authentication flow but never submits a real exchange order — it simulates
# fills against live order books. Requires DRY_RUN=false and PRIVATE_KEY set.
PAPER_TRADE=false
LIVE_SIGNING_VERIFIED=false
# ---- LIVE mode (control-plane only) ----
# polyuni's LIVE mode is a real, audited operator-intent state machine — the
# dashboard makes it unambiguous whether LIVE or PAPER is armed, and every
# order-submission boundary checks and logs that state — but there is no real
# exchange order-submission code path in this build. Arming LIVE here records
# operator intent only; it can never place a real order. This is intentional,
# not a placeholder for a future flip.
LIVE_CONTROL_STATE_PATH=state/live_control.json
LIVE_CONTROL_AUDIT_PATH=state/live_control_audit.jsonl

# ---- Crash recovery & alerting (OPTIONAL) ----
# A Discord or Telegram incoming-webhook URL. Empty (default) disables all
# alerting; the bot runs normally either way.
ALERT_WEBHOOK_URL=
ALERT_HEARTBEAT_FILE=state/HEARTBEAT
ALERT_HEARTBEAT_TIMEOUT_S=10.0

# ---- Linked venue accounts (read-only; optional) ----
# The dashboard can show your real Polymarket / Kalshi balances, positions,
# P&L and volume next to the paper engine. Nothing here can place an order.
# You can also link from the dashboard instead of setting these.
# Polymarket: your public profile wallet address (no private key needed).
POLYMARKET_ADDRESS=
# Kalshi: API key ID + path to its RSA private key (Account → API keys).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# prod or demo
KALSHI_ENV=prod
# Seconds between venue account refreshes.
VENUE_REFRESH_S=20

# ---- Scope ----
# true = only the rotating BTC up/down windows (the dashboard toggle sets this per run)
BTC_ONLY=false

# ---- LIVE trading (real money, off by default) ----
# Live orders need ALL of: this flag, a valid PRIVATE_KEY (+ PROXY_WALLET for
# polymarket.com accounts), and LIVE picked for Polymarket in the dashboard
# with a typed confirmation. Orders are fill-or-kill and capped below.
ARBITER_LIVE_TRADING=disabled
# eoa | proxy (email/Magic accounts) | safe
POLYMARKET_SIGNATURE_TYPE=proxy
LIVE_MAX_ORDER_USD=5
LIVE_MAX_OPEN_USD=25
LIVE_MAX_SESSION_LOSS_USD=25
# Protective exits cross the bid by this much so they actually execute.
LIVE_EXIT_SLIPPAGE=0.02
# On-chain token approvals spend gas; polymarket.com accounts usually have them already.
LIVE_BROADCAST_APPROVALS=false

# ---- Venue the engine trades (the dashboard's Polymarket / Kalshi switch sets this per run) ----
VENUE=polymarket
# Kalshi quadratic taker-fee multiplier and the BTC series used for "BTC only".
KALSHI_FEE_RATE=0.07
KALSHI_BTC_SERIES=KXBTC15M
