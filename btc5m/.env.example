# ============================================================================
# Polymarket Arb Bot — configuration
# Copy to `.env` and edit. Everything below has a safe default in config.py.
# ============================================================================

# ---- API endpoints (COLD + HOT) ----
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com

# ---- Market scope ----
# Comma-separated whitelist of market slugs/ids to track. Empty = use tag filter.
MARKET_WHITELIST=
# Tag filter used when whitelist is empty (e.g. "Crypto", "Btc", "Politics").
MARKET_FILTER_TAG=Crypto
# Only track markets whose question/title or outcomes mention these (comma list, lowercased).
MARKET_KEYWORDS=btc,bitcoin
# When true (default), track ALL binary YES/NO markets for max edge capture.
# When false, narrow scope to MARKET_KEYWORDS. Whitelist always wins if set.
MARKET_BROAD_SCAN=true

# ---- Strategy (the ONLY edge: combined ask < 1.00 - MIN_EDGE) ----
# Buffer covering fees + slippage. Trade only when YES+NO < 1.00 - MIN_EDGE.
MIN_EDGE=0.01
# Base order size (shares) per leg.
ORDER_SIZE=10.0

# ---- Execution auth (leave blank for DRY_RUN) ----
# Private key of the trading wallet (0x...). If empty, bot runs in DRY_RUN.
PRIVATE_KEY=
# Optional proxy/funder wallet address (the address that receives fills).
PROXY_WALLET=
# Deprecated project-level key; current live order auth uses POLYMARKET_API_*.
CLOB_API_KEY=
# Polymarket CLOB V2 API credentials (L2 HMAC auth). Leave blank on the first
# authenticated PAPER_TRADE run; the SDK derives them locally. Real exchange
# order submission is intentionally unbuilt in this product release.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# London Strategic Edge API key (vault key for /vault/candles and /vault/export).
# This placeholder works for historical candle data. It does NOT work for the
# economic calendar endpoint (/economic_calender), which requires the SPA's anon
# key (71f880e1…, see scrapers/page_agent_runner.py:71) or a real signup key.
# See docs/lse_api_key_acquisition.md and the "Macro calendar fallback sources"
# section of README.md for details.
LSE_API_KEY=lse_live_00000000000000000000000000000000

# ---- Polygon status / paper signing ----
# Read-only balance/status checks use eth_getBalance and eth_call. PAPER_TRADE
# signs synthetic approval payloads locally but never broadcasts them.
POLYGON_RPC_URL=https://polygon.drpc.org
# Maximum gas price (gwei) for approval txs at startup. Set to 0 to auto (unlimited).
APPROVAL_MAX_GAS_PRICE_GWEI=80.0

# ---- Paper-fill fidelity ----
# How PAPER_TRADE decides whether a leg fills. "rest_book" (default) fetches
# each leg's real order book at submission time and requires full requested
# depth within the limit price -- a leg can genuinely fail to fill, which is
# what exercises the partial-fill/hedge recovery path in execution.py.
# "decision_snapshot" skips that REST round trip and always fills at the WS
# decision price -- faster, but every fire "fills" 100% of the time with no
# depth/slippage modeling. Use decision_snapshot only for quick local iteration,
# never for evidence you intend to treat as go-live proof.
PAPER_FILL_SOURCE=rest_book

# ---- Transport ----
# Prefer WebSocket for book updates (fastest). Falls back to polling on any error.
USE_WS=true
# Polling interval (seconds) used only when WS is off / failing.
POLL_INTERVAL_S=0.25
# How often to rebuild the market cache in the background (seconds).
CACHE_REFRESH_INTERVAL_S=300
# Force a full discovery on startup even if a fresh cache exists.
FORCE_CACHE_REBUILD=false

# ---- Risk ----
MAX_POSITION_PER_MARKET=200.0
MAX_TOTAL_CAPITAL=1000.0
MIN_LIQUIDITY_PER_SIDE=5.0
STALE_BOOK_TIMEOUT_S=5.0
# (REMOVED 2026-08-11) MAX_SPREAD_DRIFT — orphan env var, referenced NOWHERE in
# config.py or any module. Preserved here as a comment so operators who have it
# in their .env know it is a no-op. Re-add to config.py + this file only if a
# spread-drift gate is actually implemented.
DAILY_KILL_SWITCH_USD=500.0
# Hard cap on residual losses per partial-fill event before the kill switch trips.
PARTIAL_LOSS_CAP_USD=25.0
# When hedging a missing leg, only do so if remaining edge covers this floor.
PARTIAL_HEDGE_MIN_EDGE=0.0
# Maximum time gap (ms) between legs before treating as partial fill.
MAX_LEG_GAP_MS=300
# Slippage stress buffer applied on top of entry edge for slice survival test.
SLIPPAGE_STRESS_BUFFER=0.01
# Maximum age (ms) of the older leg quote before rejecting a fire.
MAX_QUOTE_AGE_MS=500
# Hold paired-leg evaluation this long so adjacent CLOB frames form one coherent pair.
CROSS_LEG_SETTLE_MS=10.0
# Path to a file; if it exists, trading halts immediately (manual emergency stop).
EMERGENCY_STOP_FILE=state/EMERGENCY_STOP

# ---- Observability ----
LOG_JSONL=state/bot.jsonl
LOG_LEVEL=INFO

# ---- Safety ----
# Safe local mode. The setup wizard requires exactly one of DRY_RUN/PAPER_TRADE.
DRY_RUN=true
# PAPER_TRADE: when dry_run=false and PAPER_TRADE=true, the bot runs the real
# authentication flow but submit_order() NEVER hits the
# exchange — it simulates a fill using the live order book's best_ask/best_bid at the
# time of submission. REST paper mode revalidates both full-size legs first and
# walks visible depth to a full-size VWAP; insufficient depth is rejected.
# Requires DRY_RUN=false and a configured PRIVATE_KEY.
PAPER_TRADE=false
# Authenticated paper mode currently requires this to be true. This does not
# enable real orders: the persisted control flag and an independent hard-coded
# "endpoint unbuilt" gate both remain in force.
LIVE_SIGNING_VERIFIED=false
# Dashboard/operator control state and append-only audit locations.
LIVE_CONTROL_STATE_PATH=state/live_control.json
LIVE_CONTROL_AUDIT_PATH=state/live_control_audit.jsonl

# ---- TASK B: Crash recovery & alerting (OPTIONAL) ----
# A Discord or Telegram incoming-webhook URL. When EMPTY (default), all alerting is
# disabled and the bot runs normally — alerting is never required.
#
# When set, the bot writes a heartbeat file every price tick and fires webhook alerts
# on:
#   * bot crash / hang        (stale heartbeat — detected by the watchdog monitor)
#   * emergency stop triggered (EMERGENCY_STOP_FILE appeared)
#   * PARTIAL_LOSS_CAP_USD kill switch tripped
#   * WebSocket disconnected > STALE_BOOK_TIMEOUT_S
#
# A separate monitor script watches the heartbeat externally:
#   python monitoring/watchdog.py
# It must run as a SEPARATE process so it survives a bot crash/OOM. It will alert if
# the heartbeat goes stale (crash/hang).
ALERT_WEBHOOK_URL=
# File the bot touches on every tick; the watchdog monitor checks its freshness.
ALERT_HEARTBEAT_FILE=state/HEARTBEAT
# Seconds without a heartbeat before the watchdog declares a crash/hang and alerts.
ALERT_HEARTBEAT_TIMEOUT_S=10.0

# ---- BTC 5-minute window mode (default) ----
WINDOW_MODE=true
WINDOW_ASSET=btc
WINDOW_TIMEFRAME=5m
WINDOW_SECONDS=300
WINDOW_PRE_RESOLVE_S=30
NO_ENTRY_SECONDS=5
